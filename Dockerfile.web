FROM node:22

# Chromium headless + desktop libs needed by @react-native/debugger-shell (React Native DevTools),
# which is a Chromium-based browser. Source is bind-mounted at runtime; this image only adds
# system libraries (no app code).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    libpangocairo-1.0-0 libpango-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
    libgtk-3-0 libnotify4 libxss1 libxtst6 libatspi2.0-0 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*
